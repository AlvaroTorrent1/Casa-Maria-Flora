---
import '../styles/global.css';
import ScrollToTop from '../components/ScrollToTop.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = 'Casa Maria Flora: boutique Airbnb in Ojen near Marbella for a peaceful stay surrounded by nature.',
  image = '/og-image.jpg'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const htmlLang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script is:inline>
      (() => {
        // The home pages are prerendered, so resolve an explicit incoming
        // language before the page and booking iframe start loading.
        if (!['/', '/es', '/es/'].includes(window.location.pathname)) return;
        const query = new URLSearchParams(window.location.search);
        const language = query.get('lang');
        if (!['en', 'es'].includes(language) || language === document.documentElement.lang) return;
        const validDate = value => {
          if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
          const date = new Date(`${value}T00:00:00Z`);
          return Number.isFinite(date.valueOf()) && date.toISOString().slice(0, 10) === value;
        };
        const start = query.get('check_in');
        const end = query.get('check_out');
        const next = new URLSearchParams();
        if (validDate(start) && validDate(end) && end > start) {
          next.set('check_in', start);
          next.set('check_out', end);
        }
        const contact = query.get('contact');
        if (contact === 'success' || contact === 'error') next.set('contact', contact);
        next.set('lang', language);
        const safeAnchors = ['#booking-widget', '#booking', '#features', '#gallery', '#faq', '#about-us', '#contact'];
        const anchor = safeAnchors.includes(window.location.hash) ? window.location.hash : '';
        window.location.replace(`${language === 'es' ? '/es' : '/'}?${next}${anchor}`);
      })();
    </script>
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap" 
      rel="stylesheet" 
    />
    
    <!-- View Transitions -->
    <meta name="view-transition" content="same-origin" />
  </head>
  
  <body class="min-h-screen flex flex-col">
    <slot />
    <ScrollToTop />
    <script is:inline type="module" src="/google-vr-booking-link.js"></script>
  </body>
</html>

<style is:global>
  /* Ensure smooth transitions between pages */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
  
  /* Selection color */
  ::selection {
    background-color: var(--color-accent);
    color: var(--color-background);
  }
</style>
